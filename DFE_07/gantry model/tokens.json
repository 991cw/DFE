        "400": "var(--accent-400)",
        "500": "var(--accent-500)",
        "600": "var(--accent-600)",
        "700": "var(--accent-700)",
        "800": "var(--accent-800)",
        "900": "var(--accent-900)",
        "DEFAULT": "var(--color-accent)"
      },
      "success": "var(--color-success)",
      "warning": "var(--color-warning)",
      "danger": "var(--color-danger)"
    },
    "fontFamily": {
      "heading": "var(--font-heading)",
      "body": "var(--font-body)",
      "mono": "var(--font-mono)"
